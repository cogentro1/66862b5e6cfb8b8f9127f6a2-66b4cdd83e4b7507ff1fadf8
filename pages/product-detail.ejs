  <style>
    .image-crop {
    width: 168.73px !important; /* Full width of container */
    height: 128.4px !important; /* Fixed height */
    object-fit: cover !important; /* Ensures image covers the area */
    object-position: bottom !important; /* Focus on bottom of the image */
}

