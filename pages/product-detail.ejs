    padding: 0px 0px 20px 0px !important;
}
.price{
    position: absolute;
    right: 10px;
    bottom: 10px;
}

.slick-initialized.slick-slide{
    height: 100% !important;
}
.product-box-3{
    height: 245px !important;
}
  </style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    console.log("Script loaded and DOM fully loaded");

    const variantSelectors = document.querySelectorAll('.variant-selector');
    const priceElement = document.querySelector('#product-price');
    const variantElement = document.querySelector('#variant-display');
    const addToCartButton = document.querySelector('#add-to-cart');
    const quantityInput = document.querySelector('.qty-input');

    // Variant Selection Logic
    variantSelectors.forEach(function(selector) {
        selector.addEventListener('click', function() {
            console.log('Variant clicked');

            // Get the selected variant's details
            const selectedPrice = this.getAttribute('data-price');
            const selectedAttributes = this.getAttribute('data-attributes');

            // Update the price display
            if (priceElement) {
                priceElement.textContent = selectedPrice + ' £';
            }
            if (variantElement) {
                variantElement.textContent = selectedAttributes;
            }

            console.log('Selected Variant:', {
                price: selectedPrice,
                attributes: selectedAttributes
            });
        });
    });

    // Function to get selected variant index
    function getSelectedVariantIndex() {
        let selectedVariant = document.querySelector('.variant-selector:checked');
        return selectedVariant ? 
            Array.from(variantSelectors).indexOf(selectedVariant) : 
            -1;
    }

    // Add to Cart functionality (Now sends an AJAX request to update the cart server-side)
    if (addToCartButton) {
        addToCartButton.addEventListener('click', function(e) {
            e.preventDefault();
            console.log("Add to Cart button clicked");

            const productId = '<%= product._id %>';
            const quantity = parseInt(quantityInput.value) || 1;
            const variantIndex = getSelectedVariantIndex();

            console.log(`Product ID: £{productId}, Quantity: £{quantity}, Variant Index: £{variantIndex}`);

            // Prepare cart item object
            const cartItem = {
                productId: productId,
                quantity: quantity,
                hasVariants: <%= product.variants && product.variants.length > 1 %>,
                variantIndex: variantIndex
            };

            console.log("Cart Item to add:", cartItem);

            // Send AJAX request to update cart on server
            fetch('/cart', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(cartItem)
            })
            .then(response => response.json())
            .then(data => {
                console.log("Server response:", data);
 
    window.location.href = "/cart"; // Redirect to cart page
            })
            .catch(error => {
                console.error("Error adding to cart:", error);
                alert('Failed to add product to cart. Please try again.');
            });
        });
    }

    // Quantity Controls
   


});

    </script>