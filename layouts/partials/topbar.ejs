
<!-- Topbar Start -->
<div class="container-fluid">
    <div class="row bg-secondary py-1 px-xl-5">
        <div class="col-lg-6 d-none d-lg-block">
            <div class="d-inline-flex align-items-center h-100">
                <div class="headline flicker">
                    ⭐ Special Offers: Buy one get one free on all appetizers! Enjoy 20% off on your first order! ⭐
                </div>
            </div>
        </div>
        <div class="col-lg-6 text-center text-lg-right">
            <div class="d-inline-flex align-items-center">
                <div class="btn-group">
                    <% if(user) { %>
                        <button type="button" class="btn btn-sm btn-light dropdown-toggle" data-toggle="dropdown">Hi <%-
                                user.name %></button>
                        <div class="dropdown-menu dropdown-menu-right">
                            <a href="/profile" class="nav-link active">
                                <button class="dropdown-item" type="button">Profile</button>
                            </a>
                            <a href="/order" class="nav-link active">
                                <button class="dropdown-item" type="button">Orders</button>
                            </a>
                            <a href="/logout" class="nav-link active">
                                <button class="dropdown-item" type="button">Logout</button>
                            </a>
                            <a href="/changePassword" class="nav-link active">
                                <button class="dropdown-item" type="button">Change Password</button>
                            </a>
                        </div>
                    <% } else { %>
                        <button type="button" class="btn btn-sm btn-light dropdown-toggle" data-toggle="dropdown">My
                            Account</button>
                        <div class="dropdown-menu dropdown-menu-right">
                            <a href="/registration" class="nav-link active">
                                <button class="dropdown-item" type="button">Sign in</button>
                            </a>
                            <a href="/registration" class="nav-link active">
                                <button class="dropdown-item" type="button">Sign up</button>
                            </a>
                        </div>
                    <% } %>
                </div>
                <div class="btn-group mx-2">
                    <button type="button" class="btn btn-sm btn-light dropdown-toggle"
                        data-toggle="dropdown">USD</button>
                    <div class="dropdown-menu dropdown-menu-right">
                        <button class="dropdown-item" type="button">EUR</button>
                        <button class="dropdown-item" type="button">GBP</button>
                        <button class="dropdown-item" type="button">CAD</button>
                    </div>
                </div>
                <div class="btn-group">
                    <button type="button" class="btn btn-sm btn-light dropdown-toggle"
                        data-toggle="dropdown">EN</button>
                    <div class="dropdown-menu dropdown-menu-right">
                        <button class="dropdown-item" type="button">FR</button>
                        <button class="dropdown-item" type="button">AR</button>
                        <button class="dropdown-item" type="button">RU</button>
                    </div>
                </div>
            </div>
            <div class="d-inline-flex align-items-center ">
                <a href="" class="btn px-0 ml-2">
                    <i class="fas fa-heart text-dark"></i>
                    <span class="badge text-dark border border-dark rounded-circle"
                        style="padding-bottom: 2px;">0</span>
                </a>
                <a href="/cart" class="btn px-0 ml-2" id="shopping-cart-link">
                    <i class="fas fa-shopping-cart text-dark"></i>
                    <span class="badge text-dark border border-dark rounded-circle" style="padding-bottom: 2px;">
                     <%= cartCount %>
                    </span>
                </a>
            </div>
        </div>
    </div>
    <div class="row align-items-center bg-light py-3 px-xl-5 d-none d-lg-flex">
        <div class="col-lg-4">
            <a href="" class="text-decoration-none">
                <span class="h1 text-uppercase text-light px-2" style="background-color: #e21b70ff;">Panda </span>
                <span class="h1 text-uppercase  bg-light px-2 ml-n1" style="color:  #e21b70ff; border: 2px solid #e21b70ff;; padding: 0px;">MAX</span>
            </a>
        </div>
        <div class="col-lg-4 col-6 text-left">
            <form action="">
                <div class="input-group">
                    <input type="text" class="form-control" placeholder="Search for products">
                    <div class="input-group-append">
                        <button class="input-group-text bg-transparent text-primary" id="search-btn">
                            <i class="fa fa-search"></i>
                        </button>
                    </div>
                </div>
            </form>
        </div>
        <div class="col-lg-4 col-6 text-right">
            <p class="m-0">Customer Service</p>
            <h5 class="m-0">+923166248416</h5>
        </div>
    </div>
</div>
<!-- Topbar End -->

<script>
    $(function () {
        $('#search-btn').click(function (event) {
            event.preventDefault();
            console.log('search-btn clicked')
            window.location.href = '/shop'
        });
    });
</script>
