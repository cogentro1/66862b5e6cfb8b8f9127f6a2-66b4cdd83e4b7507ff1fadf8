<body>
    <!-- model for editing the profile data -->
    <div class="container-fluid">
        <div class="row">
            <!-- Profile Table Start -->
            <div class="col d-flex justify-content-center align-items-center p-3">
                <div class="shadow-lg bg-body-tertiary rounded col-md-10 col-sm-12 col-12 mt-2 p-2 ">
                    <div>
                        <h4 style="margin-left: 1%; margin-top: 3%; margin-bottom: 3%; display: inline;">
                            Change Password
                        </h4>
                        <hr>
                    </div>
                    <form id="change-password-form">
                        <div class=" p-30 mb-2">
                            <div class="row">
                                <div class="col-md-12 form-group">
                                    <label>Old Password</label>
                                    <input name="password" class="form-control" type="password"
                                        placeholder="Enter your current password">
                                </div>
                                <div class="col-md-12 form-group">
                                    <label>New Password</label>
                                    <input name="newPassword" class="form-control" type="password"
                                        placeholder="Enter your new password">
                                </div>
                                <div class="col-md-12 form-group">
                                    <label>Confirm Password</label>
                                    <input name="confirmPassword" class="form-control" type="password"
                                        placeholder="Enter your confirm new password">
                                </div>
                                <div class="col-md-12 form-group">
                                    <button type="button" id="change-password-button"
                                        class="btn btn-primary font-weight-bold">
                                        Change Password
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</body>
<script>
    $(function () {
        // for change password and saving it 
        $('#change-password-form').validate({
            rules: {
                password: {
                    required: true,
                },
                newPassword: {
                    required: true,
                },
                confirmPassword: {
                    required: true
                },
            },
            messages: {
                password: "Please enter your valid name",
                newPassword: "Please enter your valid email address",
                confirmPassword: "Please enter your valid phone",
            }
        });
        //onSubmit button
        $('#change-password-button').click(function (event) {
            event.preventDefault();
            console.log("Button Clicked")
            let formData = {
                'password': $('input[name=password]').val(),
                'newPassword': $('input[name=newPassword]').val(),
                'confirmPassword': $('input[name=confirmPassword]').val(),
            }
            console.log('formData is ', formData)
            // if ($('#exampleModal form').valid()) {
            if ($('#change-password-form').valid()) {
                console.log('Yes, validated');
                if (formData.newPassword === formData.confirmPassword) {
                    // toastr.success('Both password are equal');
                    checkAndChangePassword(formData)
                }
                else {
                    toastr.error('Please enter correct password');
                }
                // EditProfile()
                // Perform further actions or submit the form
            } else {
                console.log('Not validated');
            }
        })
        function checkAndChangePassword(formData) {
            console.log('formData in checkAndChangePassword ', formData)
            $.ajax({
                url: '/checkNchangePassword',
                method: 'put',
                data: formData,
                success: function (response) {
                    console.log('response', response)
                    toastr.success('Data Updated Successfully');
                    window.location.href = '/registration';
                },
                error: function (xhr, status, error) {
                    if (xhr.status === 404) {
                        toastr.error(xhr.responseJSON.message); // Display the error message
                    } else {
                        toastr.error('Something went wrong');
                    }
                }
            })
        }

    });
</script>
<style>
    .error {
        color: red;
    }
</style>