<body>
    <div class="container-fluid">
        <div class="row">
            <!-- Order Table Start -->
            <% if (order.length> 0) { %>
                <% for (let index=0; index < order.length; index++) { %>
                    <div class="col-md-12 col-sm-12 col-12 d-flex justify-content-center align-items-center p-3">
                        <div class="shadow-lg bg-body-tertiary rounded col-md-12 col-sm-12 col-12 mt-4 p-3">
                            <h5 style="display: inline; margin-left: 2%; ">Order #1587203<%- order[index]?.reference %>
                            </h5>

                            <button class="btn btn-primary viewOrderBtn " style="display: inline; margin-left: 75%;"
                                data-id="<%- order[index]._id%>">
                                View Detail
                            </button>
                            <hr>
                          
                            <% for (let i=0; i < order[index].products.length; i++) { %>
                              
                                <div class="row">
                                    <div class="col-md-2" style="padding-left: 2%;">
                                        <img src="<%- order[index]?.products[i]?.product?.featuredImage?.fileSrc || 'https://altcabs.s3.eu-west-2.amazonaws.com/promptoo/b8a871b0-8449-11ee-ab5a-299beb6e5596hotel3.JPEG' %>" alt="Product Image" width="120" height="140">

                                    </div>
                                    <div class="col-md-2" style="padding-top: 5%;">
                                        <%- order[index]?.products[i]?.product?.name %>
                                    </div>
                                    <div class="col-md-2" style="padding-top: 5%;">
                                        Qty: <%- order[index]?.products[i]?.quantity %>
                                    </div>
                                    <div class="col-md-2" style="padding-top: 5%;">
                                        Rs. <%- order[index]?.totalAmount %>
                                    </div>
                                    <div class="col-md-2" style="padding-top: 5%;">
                                        <span class="badge badge-danger p-3 rounded-pill" style="font-size: 20;">
                                            <%= order[index]?.order_status %>
                                        </span>
                                    </div>
                                    <div class="col-md-2" style="padding-top: 5%;">
                                        Dilivered on: 00:00:00
                                    </div>
                                </div>
                                <hr>
                                <% } %>
                        </div>
                    </div>
                    <% } %>
                        <% } else { %>
                            <div
                                class="col-md-12 col-sm-12 col-12 d-flex justify-content-center align-items-center p-3">
                                <div class="shadow-lg bg-body-tertiary rounded col-md-12 col-sm-12 col-12 mt-4 p-3">
                                    No data available
                                </div>
                            </div>
                            <% } %>
        </div><!-- main div end -->
    </div>
</body>
<script>
    $(function () {
        //for viewing one detailed ticket
        $(document).on('click', '.viewOrderBtn', function () {
            const orderId = $(this).data('id')
            console.log('order', orderId)
            window.location.href = '/viewSingleOrder/' + orderId;
        });
    });
</script>