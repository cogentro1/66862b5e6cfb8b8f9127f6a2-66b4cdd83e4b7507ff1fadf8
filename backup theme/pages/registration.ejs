<div class="registration-container">
	<div class="main">
		<input type="checkbox" id="chk" aria-hidden="true">

		<div class="signup">
			<form id="signUpDiv">
				<label id="signUpTitle" for="chk" aria-hidden="true">Sign up</label>
				<input id="userName" type="text" name="name" placeholder="User name" required="">
				<input type="email" name="email" placeholder="Email" required="">
				<input type="password" name="password" placeholder="Password" required="">
				<input type="text" name="phone" placeholder="Phone" required="">
				<button class="btnSubmitSignUp">Sign up</button>
			</form>
		</div>

		<div class="login">
			<form id="loginDiv">
				<label id="loginTitle" for="chk" aria-hidden="true">Login</label>
				<input type="email" name="loginEmail" placeholder="Email" required="">
				<input type="password" name="loginPassword" placeholder="Password" required="" type="password">
				<button class="btnSubmitLogin">Login</button>
			</form>
		</div>
	</div>
</div>
<script>
	$(function () {
		//from validation for login 
		$('#loginDiv').validate({
			rules: {
				email: {
					required: true,
					email: true
				},
				password: {
					required: true
				},
			},
			messages: {
				email: "Please enter your valid email address",
				password: "Please enter your valid password",
			}
		});
		//onSubmit button
		$('.btnSubmitLogin').click(function (event) {
			event.preventDefault();
			console.log("Button Clicked")
			if ($('#loginDiv').valid()) {
				console.log("Valid")
				login()
			} else {
				console.log("No Valid")
			}
		})
		function login() {
			let formData = {
				'email': $('input[name=loginEmail]').val(),
				'password': $('input[name=loginPassword]').val(),
			}
			console.log('formData is ', formData)
			$.ajax({
				url: '/login',
				method: 'post',
				data: formData,
				success: function (response) {
					console.log('response', response)
					toastr.success('User login successfully');
					// setTimeout(function () {
					window.location.href = '/';
					// }, 1000)
				},
				error: function (xhr, status, error) {
					toastr.error(xhr.responseJSON.message);
				}
			})
		}
		//from validation for signUp
		$('#signUpDiv').validate({
			rules: {
				name: {
					required: true,
				},
				email: {
					required: true,
					email: true
				},
				password: {
					required: true
				},
				phone: {
					required: true
				},
			},
			messages: {
				name: "Please enter your valid name",
				email: "Please enter your valid email address",
				password: "Please enter your valid password",
				phone: "Please enter your valid phone",
			}
		});
		//onSubmit button
		$('.btnSubmitSignUp').click(function (event) {
			event.preventDefault();
			console.log("Button Clicked")
			if ($('#signUpDiv').valid()) {
				console.log("Valid")
				signUp()
			} else {
				console.log("No Valid")
			}
		})
		function signUp() {
			let formData = {
				'name': $('input[name=name]').val(),
				'email': $('input[name=email]').val(),
				'password': $('input[name=password]').val(),
				'phone': $('input[name=phone]').val(),
			}
			console.log('formData is ', formData)
			$.ajax({
				url: '/signUp',
				method: 'post',
				data: formData,
				success: function (response) {
					console.log('response', response)
					toastr.success('User registered successfully');
					setTimeout(function () {
						window.location.href = '/registration';
					}, 1000)
				},
				error: function (xhr, status, error) {
					toastr.error(xhr.responseJSON.message);
				}
			})
		}
	})
</script>

