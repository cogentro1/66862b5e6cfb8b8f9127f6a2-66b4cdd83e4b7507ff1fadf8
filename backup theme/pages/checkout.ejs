        </div>
        <div class="col-lg-4">
            <h5 class="section-title position-relative text-uppercase mb-3"><span class="bg-secondary pr-3">Order
                    Total</span></h5>
            <div class="bg-light p-30 mb-5">

                <!-- mapping all products from add to cart to checkout using cookies -->
                <% if (products) { let totalPrices=0; let count=0%>
                    <div class="border-bottom">
                        <h6 class="mb-3">Products</h6>
                        <% for( let i=0; i < products.length; i++ ) { let product=products[i]; %>
                            <% let name=product?.name %>
                                <% let price=product?.price %>
                                    <% let quantity=product?.quantity %>
                                        <% let totalPrice=price * quantity %>
                                            <% totalPrices=totalPrice + totalPrices%>
                                                <div class="d-flex justify-content-between">
                                                    <p>
                                                        <%= name%>
                                                    </p>
                                                    <p>
                                                        <%= quantity%> <i class="fas fa-times"></i>
                                                            <%= price%>
                                                    </p>
                                                    <p>
                                                        <%= totalPrice %>
                                                    </p>
                                                </div>
                                                <% } %>
                    </div>
                    <div class="border-bottom pt-3 pb-2">
                        <div class="d-flex justify-content-between mb-3">
                            <h6>Subtotal</h6>
                            <h6 id="subtotalprice" data-subtotal="<%- totalPrices %>">$<%= totalPrices %>
                            </h6>
                        </div>
                        <div class="d-flex justify-content-between">
                            <h6 class="font-weight-medium">Shipping</h6>
                            <h6 class="font-weight-medium" id="shippingPrice" data-shippingFees="10">$10</h6>
                        </div>
                    </div>
                    <div class="pt-2">
                        <div class="d-flex justify-content-between mt-2">
                            <h5>Total</h5>
                            <h5 id="totalPriceData" data-totalprice="<%- totalPrices+10 %>">$<%= totalPrices+10 %>
                            </h5>
                        </div>
                    </div>
                    <% } else { %>
                        <p>No product</p>
                        <% }%>
            </div>
            <div class="mb-5">
                <h5 class="section-title position-relative text-uppercase mb-3"><span
