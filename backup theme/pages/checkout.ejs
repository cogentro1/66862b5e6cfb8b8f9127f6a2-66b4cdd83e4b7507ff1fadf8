<script>
    $(function () {
        //validation for placeOrder
        $('#billing-form').validate({
            rules: {
                firstName: {
                    required: true
                },
                lastName: {
                    required: true
                },
                email: {
                    required: true,
                    email: true
                },
                mobileNo: {
                    required: true,
                    // phoneUS: true
                },
                addressLine1: {
                    required: true
                },
                city: {
                    required: true
                },
                state: {
                    required: true
                },
                zipCode: {
                    required: true,
                    // zipcodeUS: true
                },
                country: {
                    required: true
                }
            },
            messages: {
                firstName: 'Please enter your first name',
                lastName: 'Please enter your last name',
                email: 'Please enter a valid email address',
                mobileNo: 'Please enter a valid phone number',
                addressLine1: 'Please enter your address',
                city: 'Please enter your city',
                state: 'Please enter your state',
                zipCode: 'Please enter a valid zip code',
                country: 'Please enter your country'
            },
            // errorPlacement: function(error, element) {
            //     console.log("ERROR: ",error)
            //     console.log("element: ",element)
            //     error.insertAfter(element);
            // }
        });
        // Submit the form when the "Place Order" button is clicked
        $('#place-order-button').click(function (event) {
            event.preventDefault();
            console.log("Button Clicked")
            var payment = $('input[name=payment]:checked').val()
            console.log("value of payment is:", payment)

            if ($('#billing-form').valid()) {
                console.log("Valid")
                placeOrder(payment)
            } else {
                console.log("No Valid")
            }

        })

        function placeOrder(payment) {
            var formData = {
                'firstName': $('input[name=firstName]').val(),
                'lastName': $('input[name=lastName]').val(),
                'email': $('input[name=email]').val(),
                'mobileNo': $('input[name=mobileNo]').val(),
                'addressLine1': $('input[name=addressLine1]').val(),
                'addressLine2': $('input[name=addressLine2]').val(),
                'country': $('input[name=country]').val(),
                'city': $('input[name=city]').val(),
                'state': $('input[name=state]').val(),
                'zipCode': $('input[name=zipCode]').val(),
                'placeId': $('input[name=placeId]').val(),
                // 'createAccount': $('input[name=createAccount]').is(':checked'),
                // 'shipToDifferentAddress': $('input[name=shipToDifferentAddress]').is(':checked'),
                // 'shippingFirstName': $('input[name=shippingFirstName]').val(),
                // 'shippingLastName': $('input[name=shippingLastName]').val(),
                // 'shippingEmail': $('input[name=shippingEmail]').val(),
                // 'shippingMobileNo': $('input[name=shippingMobileNo]').val(),
                // 'shippingAddressLine1': $('input[name=shippingAddressLine1]').val(),
                // 'shippingAddressLine2': $('input[name=shippingAddressLine2]').val(),
                // 'shippingCountry': $('select[name=shippingCountry]').val(),
                // 'shippingCity': $('input[name=shippingCity]').val(),
                // 'shippingState': $('input[name=shippingState]').val(),
                // 'shippingZipCode': $('input[name=shippingZipCode]').val(),
                // 'payment': $('input[name=payment]:checked').val()
            };
            const subTotal = $('#subtotalprice').data("subtotal")
            console.log("subtotalprice: ", subTotal)
            const totalAmount = $('#totalPriceData').data("totalprice")
            console.log("totalPrice: ", totalAmount)
            var shippingFee = $('#shippingPrice').data("shippingfees");
            console.log("shippingFee:", shippingFee);
            formData = { ...formData, subTotal, totalAmount, shippingFee }
            if (payment == 'cashOnDelivery') {
                formData = { ...formData, paymentType: 'cash' }
                console.log("Form Data dogg: ", formData)
                simplePostOrder()
            }
            else if (payment == 'payWithCard') {
                formData = { ...formData, paymentType: 'card' }
                console.log("Form Data dog: ", formData)
                postOrderForPaymentWithCard()
            }
            function simplePostOrder() {
                $.ajax({
                    url: '/placeOrder',
                    method: 'POST',
                    data: formData,
                    success: function (response) {
                        console.log('response dog', response);
                        toastr.success('Order places successfully');
                        window.location.href = "/";
                    },
                    error: function (xhr, status, error) {
                        toastr.error(xhr.responseJSON.message);
                    }
                });
            }
            function postOrderForPaymentWithCard() {
                $.ajax({
                    url: '/placeOrderByPayWithCard',
                    method: 'POST',
                    data: formData,
                    success: function (response) {
                        console.log('response', response);
                        toastr.success('Order places successfully');
                        window.location.href = `${response.url}`;
                        // window.location.href = "/shop";
                    },
                    error: function (xhr, status, error) {
                        toastr.error(xhr.responseJSON.message);
                    }
                });
            }
        }
        //on create account form validation
        // $('#exampleModal form').validate({
        $('#exampleModalform').validate({
            rules: {
                name: {
                    required: true,
                },
                email: {
                    required: true,
                    email: true
                },
                password: {
                    required: true
                },
                phone: {
                    required: true
                },
            },
            messages: {
                name: "Please enter your valid name",
                email: "Please enter your valid email address",
                password: "Please enter your valid password",
                phone: "Please enter your valid phone",
            }
        });
        //onSubmit button
        $('.btnSubmitSignUp').click(function (event) {
            event.preventDefault();
            console.log("Button Clicked")
            let formData = {
                'name': $('input[name=name]').val(),
                'email': $('input[name=email]').val(),
                'password': $('input[name=password]').val(),
                'phone': $('input[name=phone]').val(),
            }
            console.log('formData is ', formData)
            // if ($('#exampleModal form').valid()) {
            if ($('#exampleModalform').valid()) {
                console.log('Yes, validated');
                signUp()
                // Perform further actions or submit the form
            } else {
                console.log('Not validated');
            }
        })
        function signUp() {
            let formData = {
                'name': $('input[name=name]').val(),
                'email': $('input[name=email]').val(),
                'password': $('input[name=password]').val(),
                'phone': $('input[name=phone]').val(),
            }
            console.log('formData is ', formData)
            $.ajax({
                url: '/signUp',
                method: 'post',
                data: formData,
                success: function (response) {
                    console.log('response', response)
                    toastr.success('User registered successfully');
                    setTimeout(function () {
                        window.location.href = '/registration';
                    }, 1000)
                },
                error: function (xhr, status, error) {
                    toastr.error(xhr.responseJSON.message);
                }
            })
        }

    })

</script>
