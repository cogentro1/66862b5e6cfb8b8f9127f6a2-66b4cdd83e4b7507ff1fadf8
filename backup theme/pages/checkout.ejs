                                <input type="radio" class="custom-control-input" name="payment" id="banktransfer">
                                <label class="custom-control-label" for="banktransfer">Bank Transfer</label>
                            </div>
                        </div> -->
                        <button id="place-order-button" class="btn btn-block btn-primary font-weight-bold py-3"
                            type="submit">Place
                            Order</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <div>

    </div>
</div>
