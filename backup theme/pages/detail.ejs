<script>
    $(function () {
        let quantity = 1;
        var $minusButton = $('.btn-minus');
        var $plusButton = $('.btn-plus');
        var $addToCart = $("#addToCart");

        $minusButton.on('click', function (e) {
            e.preventDefault();
            if (quantity > 0) {
                quantity -= 1;
                console.log("Minus Quantity: ", quantity);
                $("#quantity").val(quantity);
            }
        });

        $plusButton.on('click', function (e) {
            e.preventDefault();
            quantity += 1;
            console.log("Add Quantity: ", quantity);
            $("#quantity").val(quantity);
        });

        $addToCart.on('click', function (e) {
            e.preventDefault();
            console.log("Add to cart button clicked");
            addToCart();
        });

        function addToCart() {
            var productId = $('#productId').val();

            const url = `/addToCart/${productId}?quantity=${quantity}`; // Send productId as a parameter

            console.log("URL: ", url);

            $.ajax({
                type: "POST",
                url: url,
                success: function (response) {
                    console.log("RESPONSE: ", response);
                    window.location.href = "/cart";
                },
                error: function (err) {
                    console.log("err: ", err.responseText);
                }
            });
        }

        var allAttNamesJSON = $('#allAttNames').val();
        var namesOfAtt = JSON.parse(allAttNamesJSON);
        var variantArrayJSON = $('#variantValue').val();
        var variantArray = JSON.parse(variantArrayJSON);
        var arrayOfSelectedRadioBtn = [];

        $('input[type="radio"]').on('click', function () {
            if ($(this).is(':checked')) {
                var selectedRadioName = $(this).attr('data-radioId');
                var attValue = $(this).attr('data-attName');

                for (let i = 0; i < namesOfAtt.length; i++) {
                    if (namesOfAtt[i] === selectedRadioName) {
                        arrayOfSelectedRadioBtn[i] = attValue;
                    }
                }

                for (let i = 0; i < variantArray.length; i++) {
                    for (let j = 0; j < variantArray[i].att.length; j++) {
                        const attAsString = JSON.stringify(variantArray[i].att);
                        const selectedRadioBtnAsString = JSON.stringify(arrayOfSelectedRadioBtn);

                        if (attAsString === selectedRadioBtnAsString) {
                            if (variantArray[i].att) {
                                let $container = $('<div class="divForShowingVariantDetails"></div>');
                                var $variantData = $(`
                                    <p>SKU: ${variantArray[i].sku || 'None'}</p>
                                    <p>Regular Price: ${variantArray[i].regularPrice ? `$${variantArray[i].regularPrice}` : 'None'}</p>
                                    <p>Sale Price: ${variantArray[i].salePrice ? `$${variantArray[i].salePrice}` : 'None'}</p>
                                    <p>Weight: ${variantArray[i].weight ? `$${variantArray[i].weight}` : 'None'}</p>
                                    <p>Length: ${variantArray[i].length ? `$${variantArray[i].length}` : 'None'}</p>
                                    <p>Width: ${variantArray[i].width ? `$${variantArray[i].width}` : 'None'}</p>
                                    <p>Height: ${variantArray[i].height ? `$${variantArray[i].height}` : 'None'}</p>
                                    <p>Description: ${variantArray[i].description || 'No description'}</p>
                                `);
                                $container.append($variantData);
                                $(".showingVariantDetails").empty().append($container);
                            } else {
                                $(".showingVariantDetails").empty().append("No matching variant found.");
                            }
                        }
                    }
                }
            }
        });
    });
</script>


