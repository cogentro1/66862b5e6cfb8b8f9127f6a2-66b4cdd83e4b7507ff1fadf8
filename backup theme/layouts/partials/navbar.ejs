<!-- Main Navbar -->
<div class="container-fluid mb-30" style="background-color: #e21b70ff;">
    <div class="row px-xl-12">
        <div class="col-lg-12">
            <nav class="navbar navbar-expand-lg navbar-dark py-3 py-lg-0 px-0"
                style="background-color: #e21b70ff; justify-items: center !important; margin: 0 auto !important; width: 100%;">
                <a href="" class="text-decoration-none d-block d-lg-none">
                    <span class="h1 text-uppercase text-dark bg-light px-2">Aqib</span>
                    <span class="h1 text-uppercase text-light bg-primary px-2 ml-n1">Shop</span>
                </a>
                <button type="button" class="navbar-toggler" data-toggle="collapse" data-target="#navbarCollapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse justify-content-between" id="navbarCollapse"
                    style="height:40px; justify-items: center !important; margin: 0 auto; width: 100%;">
                    <div class="navbar-nav mr-auto py-0" style=" width: 100%;">
                        <%- helpers.render_menu(menus, 'primary-menu' , { dropdownItemClass: 'nav-item dropdown' ,
                            navLinkClass: 'nav-link dropdown-toggle' ,
                            dropdownMenuClass: 'dropdown-menu rounded-0 border-0 m-0' ,
                            navItemClass: 'nav-item nav-link' , submenuClass: 'dropdown-submenu' ,
                            submenuIconClass: 'fa fa-angle-right' , dropdownIconClass: 'fa fa-angle-down' ,
                            submenuDropdownMenuClass: 'dropdown-menu rounded-0 border-0 m-0' }) %>
                    </div>
                </div>
            </nav>
        </div>
    </div>
</div>
<!-- Main Navbar End -->

<!-- Sub Navbar Start -->
<div class="container-fluid mb-30" id="sub-navbar" style="background-color: #f8f9fa;">
    <div class="row px-xl-5">
        <div class="col-lg-12">
            <nav class="navbar navbar-expand-lg navbar-light py-3 py-lg-0 px-0">
                <div class="navbar-nav w-100" id="depth1-categories">
                    <!-- Categories with depth 1 will be appended here -->
                </div>
            </nav>
        </div>
    </div>
</div>
<!-- Sub Navbar End -->

<script>
    $(function () {
        function populateDepth1Categories(categories) {
            const categoriesContainer = $('#depth1-categories');
            categoriesContainer.empty(); // Clear any existing categories

            categories.forEach(function (category) {
                if (category.depth === 1) {
                    categoriesContainer.append(
                        `<a href="/categories/${category._id}" class="nav-item nav-link">${category.name.toUpperCase()}</a>`
                    );
                }
            });
        }

        const categories = <% - JSON.stringify(categories) %>;
        populateDepth1Categories(categories);
    });

    $(document).ready(function () {
        $('.dropdown-submenu a.dropdown-item').on("click", function (e) {
            $(this).next('div').toggle();
            e.stopPropagation();
            e.preventDefault();
        });
    });
</script>

